---
import { formats } from "../data/formats.ts";
import Icon from "./Icon.astro";
---
<ul class="fmt-grid" data-testid="format-chips">
  {formats.map(f => (
    <li class="fmt-chip" title={f.ext}>
      <span class="fmt-icon"><Icon name={f.icon} /></span>
      <span class="fmt-name">{f.name}</span>
    </li>
  ))}
</ul>
