---
interface Props {
  id?: string;
  eyebrow?: string;
  heading: string;
  headingLevel?: 1 | 2;
  bg?: "tint";
  lead?: string;
  center?: boolean;
}
const { id, eyebrow, heading, headingLevel = 2, bg, lead, center } = Astro.props;
const Tag = `h${headingLevel}` as "h1" | "h2";
const band = bg === "tint" ? "band band-tint" : "band";
---
<section id={id} class={band}>
  <div class={`wrap ${center ? "text-center" : ""}`}>
    {eyebrow && <p class={`eyebrow ${center ? "justify-center" : ""}`}>{eyebrow}</p>}
    <Tag class="font-display text-2xl md:text-4xl mt-3 mb-3 leading-[1.1]">{heading}</Tag>
    {lead && <p class={`text-muted text-lg max-w-4xl mb-8 ${center ? "mx-auto" : ""}`}>{lead}</p>}
    {!lead && <div class="mb-8"></div>}
    <slot />
  </div>
</section>
