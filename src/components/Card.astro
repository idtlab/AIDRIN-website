---
import Icon from "./Icon.astro";
interface Props {
  title: string;
  icon?: string;
  accentColor?: string;
  href?: string;
  badge?: string;
}
const { title, icon, accentColor, href, badge } = Astro.props;
const Tag = href ? "a" : "div";
const style = accentColor ? `--accent:${accentColor}` : undefined;
---
<Tag
  href={href}
  style={style}
  class="ui-card hoverable"
>
  {icon && <div class="card-icon"><Icon name={icon} /></div>}
  <div class="flex items-center gap-2 mb-2">
    <h3 class="font-semibold text-lg leading-tight">{title}</h3>
    {badge && <span class="badge">{badge}</span>}
  </div>
  <slot />
</Tag>
