---
import { navLinks } from "../data/nav.ts";
import { site } from "../data/site.ts";
import ThemeToggle from "./ThemeToggle.astro";
import Icon from "./Icon.astro";
---
<header class="nav-bar">
  <div class="wrap flex items-center justify-between h-16">
    <a href="/" class="flex items-center gap-3" aria-label="AIDRIN, AI Data Readiness Infrastructure, home">
      <img src="/logo.png" alt="AIDRIN" class="nav-logo" />
      <span class="font-display font-bold text-gradient text-sm sm:text-base hidden sm:inline">AI Data Readiness Infrastructure</span>
    </a>

    <nav class="hidden md:flex items-center gap-7" aria-label="Primary">
      {navLinks.map(l => <a href={l.href} class="nav-link">{l.label}</a>)}
      <a href={site.docs} class="nav-link">Docs</a>
      <a href={site.github} class="nav-link grid place-items-center" aria-label="GitHub repository"><Icon name="github" class="w-5 h-5" /></a>
      <ThemeToggle />
      <a href={site.inspector} class="btn-primary" data-testid="cta-primary">Demo</a>
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <ThemeToggle />
      <button id="nav-toggle" type="button" class="grid place-items-center w-10 h-10 rounded-full hairline" aria-label="Open menu" aria-expanded="false">
        <span class="text-xl leading-none">☰</span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="md:hidden hidden flex-col gap-1 px-6 pb-5" aria-label="Mobile">
    {navLinks.map(l => <a href={l.href} class="nav-link py-2">{l.label}</a>)}
    <a href={site.docs} class="nav-link py-2">Docs</a>
    <a href={site.github} class="nav-link py-2">GitHub</a>
    <a href={site.inspector} class="btn-primary mt-2 justify-center">Demo</a>
  </nav>
</header>
<script is:inline>
  const b = document.getElementById("nav-toggle"), m = document.getElementById("mobile-menu");
  b?.addEventListener("click", () => {
    const open = m.classList.toggle("hidden") === false;
    m.classList.toggle("flex", open);
    b.setAttribute("aria-expanded", String(open));
    b.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  });
</script>
