---
import { Code } from "astro:components";
interface Props { tabs: { label: string; code: string; lang: string }[]; }
const { tabs } = Astro.props;
---
<div class="code-tabs" data-testid="code-tabs">
  <div class="ct-bar">
    <div class="ct-tabs" role="tablist">
      {tabs.map((t, i) => (
        <button type="button" class={`ct-tab ${i === 0 ? "is-active" : ""}`} role="tab"
          aria-selected={i === 0 ? "true" : "false"} data-i={i}>{t.label}</button>
      ))}
    </div>
    <button type="button" class="ct-copy" aria-label="Copy code">Copy</button>
  </div>
  {tabs.map((t, i) => (
    <div class="ct-panel" role="tabpanel" data-i={i} data-code={t.code} hidden={i !== 0}>
      <Code code={t.code} lang={t.lang as any} theme="github-dark" />
    </div>
  ))}
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-testid="code-tabs"]').forEach(box => {
    const tabs = box.querySelectorAll<HTMLElement>(".ct-tab");
    const panels = box.querySelectorAll<HTMLElement>(".ct-panel");
    const copy = box.querySelector<HTMLButtonElement>(".ct-copy");
    const activeCode = () =>
      box.querySelector<HTMLElement>('.ct-panel:not([hidden])')?.getAttribute("data-code") ?? "";
    tabs.forEach(tab => tab.addEventListener("click", () => {
      const i = tab.getAttribute("data-i");
      tabs.forEach(t => { const on = t === tab; t.classList.toggle("is-active", on); t.setAttribute("aria-selected", String(on)); });
      panels.forEach(p => { p.hidden = p.getAttribute("data-i") !== i; });
    }));
    copy?.addEventListener("click", async () => {
      await navigator.clipboard.writeText(activeCode());
      const prev = copy.textContent; copy.textContent = "Copied";
      setTimeout(() => { copy.textContent = prev; }, 1400);
    });
  });
</script>
