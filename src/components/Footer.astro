---
import { site } from "../data/site.ts";
import { navLinks } from "../data/nav.ts";
import { acknowledgements } from "../data/acknowledgements.ts";
---
<footer class="band-tint border-t hairline">
  <div class="wrap py-14 text-sm">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <a href="/" class="font-display text-2xl">AIDRIN</a>
        <p class="text-muted mt-2 max-w-xs">AI Data Readiness Infrastructure. Quantitatively assess and improve your dataset's readiness for AI.</p>
      </div>
      <div>
        <h3 class="font-display font-semibold uppercase tracking-wider text-xs text-muted mb-3">Resources</h3>
        {navLinks.map(l => <a class="block nav-link py-1" href={l.href}>{l.label}</a>)}
        <a class="block nav-link py-1" href={site.docs}>Documentation</a>
      </div>
      <div>
        <h3 class="font-display font-semibold uppercase tracking-wider text-xs text-muted mb-3">Connect</h3>
        <a class="block nav-link py-1" href={site.github}>GitHub</a>
        <a class="block nav-link py-1" href={site.inspector}>Demonstration</a>
        <h3 class="font-display font-semibold uppercase tracking-wider text-xs text-muted mt-5 mb-3">Contact</h3>
        <a class="block nav-link py-1" href="mailto:contact@aidrin.org">contact@aidrin.org</a>
      </div>
    </div>
    <div class="grad-bar mt-10 mb-6 max-w-[120px]"></div>
    <div class="ack-strip">
      {acknowledgements.map(a => (
        a.logo
          ? <img src={a.logo} alt={a.name} title={a.name} class="ack-logo" />
          : <span class="ack-name" title={a.name}>{a.short}</span>
      ))}
    </div>
    <p class="text-muted mt-8">© {new Date().getFullYear()} AIDRIN · AI Data Readiness Infrastructure</p>
  </div>
</footer>
